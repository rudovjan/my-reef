# Optional settings. Copy to .env before setup and start.
PORT=3000
HOST=127.0.0.1
# Defaults to http://localhost:3000. Set your exact HTTPS origin for remote access.
# PUBLIC_ORIGIN=https://reef.example.com
# Defaults to ~/.config/my-reef. Back up the entire directory privately.
# MY_REEF_DATA_DIR=/absolute/path/to/my-reef-data
